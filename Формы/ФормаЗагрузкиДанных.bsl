// -------------------------------------------------------------------
// Открытие диалога выбора каталога.
// Сохраняет выбранный путь в реквизит формы ИмяКаталога.
// -------------------------------------------------------------------
&НаКлиенте
Процедура ИмяКаталогаОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	// Вызываем общий модуль для диалога выбора каталога
	ЭтотОбъект.ИмяКаталога = _РаботаСФайлами.ПолучитьИмяКаталога();
КонецПроцедуры

// -------------------------------------------------------------------
// Загрузка содержимого всех .txt файлов из выбранного каталога.
// Результат сохраняется в реквизит формы ВнешниеДанные (одна строка).
// -------------------------------------------------------------------
&НаКлиенте
Процедура ЗагрузитьВнешниеДанные(Команда)
	ЭтотОбъект.ВнешниеДанные = _РаботаСФайлами.ЗагрузитьДанныеИзФайлов(ЭтотОбъект.ИмяКаталога);
КонецПроцедуры

// -------------------------------------------------------------------
// Главная команда: преобразование загруженных данных в табличный документ.
// 1. Проверяет, что данные загружены.
// 2. Вызывает серверную функцию, которая парсит CSV и создаёт ТабличныйДокумент.
// 3. Показывает результат пользователю.
// -------------------------------------------------------------------
&НаКлиенте
Процедура ЗагрузитьДанныеВТаблицу(Команда)
	// Проверка наличия данных - без них нечего парсить
	Если ПустаяСтрока(ЭтотОбъект.ВнешниеДанные) Тогда
		Сообщить("Сначала загрузите данные из файлов (кнопка 'ЗагрузитьВнешниеДанные')");
		Возврат;
	КонецЕсли;
	
	// Серверная функция возвращает готовый табличный документ
	ТабДок = ПолучитьТабличныйДокументНаСервере(ЭтотОбъект.ВнешниеДанные);
	// Показываем в отдельном окне
	ТабДок.Показать();
КонецПроцедуры

// -------------------------------------------------------------------
// Серверная функция-прослойка: получает строку с данными,
// формирует структуру колонок, вызывает парсер и конвертер,
// возвращает готовый ТабличныйДокумент.
// -------------------------------------------------------------------
&НаСервере
Функция ПолучитьТабличныйДокументНаСервере(СтрокаДанных)
	// Определяем структуру таблицы: имена колонок и типы для числовых
	СтруктураКолонок = Новый Структура("Фамилия, Задача, Ставка, ЧислоЧасов");
	СтруктураКолонок.Ставка = Новый ОписаниеТипов("Число");
	СтруктураКолонок.ЧислоЧасов = Новый ОписаниеТипов("Число");
	
	// 1. Парсим CSV-строку в ТаблицуЗначений
	ТаблицаДанных = _РаботаСТаблицей.ЗагрузитьДанныеВТаблицу(СтруктураКолонок, СтрокаДанных);
	
	// Отладочное сообщение: сумма по колонке Ставка (проверка, что данные загружены)
	Сообщить("Итого ставка: " + ТаблицаДанных.Итог("Ставка"));
	
	// 2. Преобразуем ТаблицуЗначений в ТабличныйДокумент для отображения
	Возврат _РаботаСТаблицей.СоздатьТабличныйДокументПоТаблицеЗначений(ТаблицаДанных);
КонецФункции