// -------------------------------------------------------------------
// Открывает диалог выбора каталога и возвращает путь к нему.
// Возвращает пустую строку, если пользователь отказался от выбора.
// -------------------------------------------------------------------
Функция ПолучитьИмяКаталога() Экспорт
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ИмяКаталога = "";
	Если Диалог.Выбрать() Тогда
		ИмяКаталога = Диалог.Каталог;
	КонецЕсли;
	Возврат ИмяКаталога;
КонецФункции

// -------------------------------------------------------------------
// Читает все файлы с расширением .txt из указанного каталога
// и объединяет их содержимое в одну строку.
// Возвращает полученную строку (CSV-данные).
// -------------------------------------------------------------------
Функция ЗагрузитьДанныеИзФайлов(ИмяКаталога) Экспорт
	Текст = Новый ТекстовыйДокумент;
	СтрокаВнешнихДанных = "";
	
	// Получаем список .txt файлов в каталоге (без вложенных папок)
	МассивФайлов = НайтиФайлы(ИмяКаталога, "*.txt", Ложь);
	
	Для Каждого Файл Из МассивФайлов Цикл
		Текст.Прочитать(Файл.ПолноеИмя); // читаем файл
		СтрокаВнешнихДанных = СтрокаВнешнихДанных + Текст.ПолучитьТекст(); // добавляем содержимое
	КонецЦикла;
	
	Возврат СтрокаВнешнихДанных;
КонецФункции