// -------------------------------------------------------------------
// Создаёт ТаблицуЗначений по описанию колонок и заполняет её данными
// из CSV-строки.
//
// Параметры
//   СтруктураКолонок    - Структура, где Ключ = имя колонки,
//                          Значение = ОписаниеТипов (или любой тип, тогда строка).
//   СтрокаВнешнихДанных - строка, содержащая CSV-данные (строки разделены ПС,
//                          колонки разделены запятыми).
// Возвращает: ТаблицаЗначений, заполненная данными.
// -------------------------------------------------------------------
Функция ЗагрузитьДанныеВТаблицу(СтруктураКолонок, СтрокаВнешнихДанных) Экспорт
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	Колонки = ТаблицаДанных.Колонки;
	
	// Создаём колонки в таблице значений согласно переданной структуре
	Для Каждого ОписаниеКолонки Из СтруктураКолонок Цикл
		Если ТипЗнч(ОписаниеКолонки.Значение) = Тип("ОписаниеТипов") Тогда
			// Если указан тип, добавляем колонку с этим типом
			Колонки.Добавить(ОписаниеКолонки.Ключ, ОписаниеКолонки.Значение);
		Иначе
			// Иначе добавляем колонку со строковым типом по умолчанию
			Колонки.Добавить(ОписаниеКолонки.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	// Разбиваем входную строку на массив строк (по символу перевода строки)
	МассивСтрок = СтрРазделить(СтрокаВнешнихДанных, Символы.ПС);
	
	// Обрабатываем каждую строку
	Для Каждого СтрокаДанных Из МассивСтрок Цикл
		Если ПустаяСтрока(СтрокаДанных) Тогда
			Продолжить; // пропускаем пустые строки
		КонецЕсли;
		
		// Разбиваем строку на колонки по запятой (CSV)
		МассивДанных = СтрРазделить(СтрокаДанных, ",", Ложь);
		СтрокаТаблицы = ТаблицаДанных.Добавить(); // добавляем новую строку в таблицу
		
		// Заполняем колонки в строке
		Для Индекс = 0 По МассивДанных.Количество() - 1 Цикл
			Попытка
				// Обрезаем пробелы и присваиваем значение
				СтрокаТаблицы[Индекс] = СокрЛП(МассивДанных[Индекс]);
			Исключение
				// Если что-то пошло не так (неверный тип, выход за границы), выводим ошибку
				СтрокаОшибки = СтрШаблон("При загрузке строки(%1) произошла ошибка: %2", СтрокаДанных, ОписаниеОшибки());
				Сообщить(СтрокаОшибки);
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаДанных;
КонецФункции

// -------------------------------------------------------------------
// Преобразует ТаблицуЗначений в ТабличныйДокумент для отображения.
// Первая строка - заголовки колонок.
// Далее идут строки данных.
//
//Параметры
//   ТаблицаЗначений - исходная таблица значений.
// Возвращает: ТабличныйДокумент.
// -------------------------------------------------------------------
Функция СоздатьТабличныйДокументПоТаблицеЗначений(ТаблицаЗначений) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	Колонки = ТаблицаЗначений.Колонки;
	
	// Шапка таблицы: имена колонок
	НомерСтроки = 1;
	НомерКолонки = 1;
	Для Каждого ТекущаяКолонка Из Колонки Цикл
		Ячейка = ТабДок.Область(НомерСтроки, НомерКолонки);
		Ячейка.Текст = ТекущаяКолонка.Имя;
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	
	// Тело таблицы: перебираем строки и колонки
	Для Каждого СтрокаТаблицы Из ТаблицаЗначений Цикл
		// Вставляем новую строку сразу за последней
		НомерСтроки = ТабДок.ВысотаТаблицы + 1;
		Для НомерКолонки = 1 По Колонки.Количество() Цикл
			Ячейка = ТабДок.Область(НомерСтроки, НомерКолонки);
			// Значение из ТаблицыЗначений приводится к строке автоматически
			Ячейка.Текст = СтрокаТаблицы[НомерКолонки - 1];
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТабДок;
КонецФункции